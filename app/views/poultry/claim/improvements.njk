{% extends './layouts/layout.njk' %}

{% block pageTitle %}{% if errorMessage %}Error: {% endif %}Did the review identify biosecurity improvements that you had previously not known about? - {{ serviceName }} - GOV.UK{% endblock %}

{% block containerStart %}
  {{
    govukBackLink({
      text: "Back",
      href: backLink
    })
  }}
{% endblock %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-row govuk-width-container govuk-!-static-margin-top-0">
      <div class="govuk-grid-column-two-thirds">
        {% if errorMessage %}
          {{ govukErrorSummary({
              titleText: "There is a problem",
              errorList:[{
                text: errorMessage.text,
                href: errorMessage.href
              }]
            })
          }}
        {% endif %}
        <div class="govuk-grid-row">
          <form method="POST" autocomplete="off" novalidate="novalidate">
            <input type="hidden" name="crumb" value="{{crumb}}"/>
            {{
              govukRadios({
                id: "biosecurityImprovements",
                name: "biosecurityImprovements",
                fieldset:{
                  legend:{
                    text: "Did the review identify biosecurity improvements that you had previously not known about?",
                    isPageHeading: true,
                    classes: "govuk-fieldset__legend--l"
                  }
                },
                errorMessage: radioErrorMessage,
                items: [
                  {
                    value:"yes",
                    text: "Yes",
                    checked: previousAnswer == "yes"
                  },
                  {
                    value: "no",
                    text: "No",
                    checked: previousAnswer == "no"
                  }
                ]
              })
            }}
            {{ govukButton({
                  text: "Continue",
                  attributes: {id: "btnContinue"},
                  preventDoubleClick: true
                })
            }}
          </form>
        </div>
      </div>
    {% endblock %}
