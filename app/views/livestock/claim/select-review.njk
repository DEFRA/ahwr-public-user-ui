{% extends './layouts/layout.njk' %}

{% block pageTitle %}{% if errorMessage %}Error: {% endif %}Which review claim this follow-up is for? - {{ serviceName }} - GOV.UK{% endblock %}

{% block containerStart %}
  {{ govukBackLink({
    text: "Back",
    href: backLink
  }) }}
{% endblock %}

{% block content %}
  <div class="govuk-grid-row govuk-width-container govuk-!-static-margin-top-0">
    <div class="govuk-grid-column-two-thirds govuk-!-static-padding-0">
      {% if errorMessage %}
        {{ govukErrorSummary({
          titleText: "There is a problem",
          errorList:[{
            text: errorMessage.text,
            href: "#reviews"
          }]
        }) }}
      {% endif %}

      <h1 class="govuk-heading-l govuk-!-margin-bottom-2">Which review is this follow-up related to?</h1>
      <p class="govuk-hint govuk-!-margin-bottom-2">A follow-up always takes place after a specific review.
        If you do not select the correct review, you may not be able to claim for future follow-ups.</p>

      <form method="POST" autocomplete="off" novalidate="novalidate">
        <input type="hidden" name="crumb" value="{{ crumb }}" />

        {{ govukRadios({
          idPrefix: "reviews",
          name: "reviews",
          errorMessage: errorMessage,
          hint: {
            html: "<b>Herd Name</b>: " + herdName + "<br><b>Species</b>: " + typeOfLivestock
          },
          items: reviews
        }) }}

        {{ govukButton({
          text: "Continue",
          attributes: { id: "btnContinue" },
          preventDoubleClick: true
        }) }}
      </form>
    </div>
  </div>
{% endblock %}