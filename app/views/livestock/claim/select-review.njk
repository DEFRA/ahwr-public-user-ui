{% extends './layouts/layout.njk' %}

        {% block pageTitle %}{% if errorMessage %}Error: {% endif %}Which review claim this follow-up is for? - {{ serviceName }} - GOV.UK{% endblock %}

        {% block containerStart %}
        {{ govukBackLink({
        text: "Back",
        href: backLink
        }) }}
        {% endblock %}

{% block content %}
    <div class="govuk-grid-row govuk-width-container govuk-!-static-margin-top-0">
        <div class="govuk-grid-column-two-thirds govuk-!-static-padding-0">
            {% if errorMessage %}
            {{ govukErrorSummary({
            titleText: "There is a problem",
            errorList:[{
            text: errorMessage.text,
            href: "#reviews"
            }]
            }) }}
            {% endif %}

            <form method="POST" autocomplete="off" novalidate="novalidate">
                <input type="hidden" name="crumb" value="{{ crumb }}" />

                {{ govukRadios({
                idPrefix: "reviews",
                name: "reviews",
                errorMessage: errorMessage,
                fieldset: {
                legend: {
                text: "Select the review claim this follow-up is for",
                isPageHeading: true,
                classes: "govuk-fieldset__legend--l"
                }
                },
                items: reviews
                })
                }}

                {{ govukButton({
                text: "Continue",
                attributes: { id: "btnContinue" },
                preventDoubleClick: true
                })
                }}
            </form>
        </div>
    </div>
{% endblock %}