{
  "name": "ahwr-public-user-ui",
  "version": "0.0.2",
  "description": "Public user UI for AHWR service",
  "homepage": "https://github.com/DEFRA/ahwr-public-user-ui",
  "main": "app/index.js",
  "type": "module",
  "engines": {
    "npm": ">=11.10.0"
  },
  "scripts": {
    "build": "webpack",
    "build:watch": "webpack --watch",
    "format": "prettier --write \"**/*.{cjs,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{cjs,js,json,md}\"",
    "test": "jest",
    "test:watch": "jest --coverage=false --onlyChanged --watch --runInBand",
    "test:watch:all": "npm-run-all --parallel test:watch build:watch",
    "lint": "eslint",
    "lint:knip": "knip --production --exclude exports",
    "lint:fix": "eslint --fix",
    "test:debug": "node --inspect-brk=0.0.0.0 ./node_modules/jest/bin/jest.js --coverage=false --onlyChanged --watch --runInBand --no-cache",
    "start:watch": "npm-run-all --parallel build:watch start:nodemon",
    "start:debug": "nodemon -r dotenv/config --inspect-brk=0.0.0.0 --ext css,js,njk --legacy-watch app/index.js",
    "start:nodemon": "nodemon -r dotenv/config --inspect=0.0.0.0 --ext css,js,njk --legacy-watch app/index.js",
    "jest": "jest",
    "postinstall": "patch-package",
    "prepare": "husky"
  },
  "author": "Defra",
  "license": "OGL-UK-3.0",
  "dependencies": {
    "@2toad/profanity": "3.2.0",
    "@aws-sdk/client-s3": "3.1006.0",
    "@aws-sdk/s3-request-presigner": "3.1006.0",
    "@defra/hapi-tracing": "1.30.0",
    "@elastic/ecs-pino-format": "1.5.0",
    "@hapi/boom": "9.1.4",
    "@hapi/catbox-memory": "5.0.1",
    "@hapi/catbox-redis": "7.0.2",
    "@hapi/cookie": "12.0.1",
    "@hapi/crumb": "8.0.1",
    "@hapi/hapi": "21.4.9",
    "@hapi/inert": "7.1.2",
    "@hapi/scooter": "8.0.0",
    "@hapi/vision": "7.0.3",
    "@hapi/wreck": "18.1.2",
    "@hapi/yar": "11.0.0",
    "@ministryofjustice/frontend": "9.0.0",
    "aws-embedded-metrics": "4.2.0",
    "blankie": "5.0.0",
    "convict": "6.2.5",
    "ffc-ahwr-common-library": "3.8.5",
    "form-data": "4.0.6",
    "global-agent": "3.0.0",
    "govuk-frontend": "6.2.0",
    "hapi-pino": "12.1.0",
    "http-status-codes": "2.3.0",
    "ioredis": "5.6.1",
    "joi": "18.2.1",
    "jquery": "3.7.1",
    "jsonwebtoken": "9.0.3",
    "jwk-to-pem": "2.0.7",
    "moment": "2.30.1",
    "nunjucks": "3.2.4",
    "pino": "10.3.0",
    "uuid": "14.0.0"
  },
  "overrides": {
    "semver": "7.5.2",
    "fast-uri": "3.1.2",
    "brace-expansion": "2.0.2",
    "fast-xml-parser": "5.7.3"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/plugin-transform-export-namespace-from": "^7.27.1",
    "@babel/plugin-transform-modules-commonjs": "7.29.7",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/user-event": "14.6.4",
    "babel-jest": "30.4.1",
    "baseline-browser-mapping": "^2.11.15",
    "cheerio": "1.2.0",
    "clean-webpack-plugin": "4.0.0",
    "css-loader": "7.1.4",
    "dotenv": "17.4.2",
    "eslint": "9.39.2",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-sonarjs": "4.2.0",
    "global-jsdom": "26.0.0",
    "html-webpack-plugin": "5.6.8",
    "husky": "9.1.7",
    "jest": "^30.2.0",
    "jest-axe": "^10.0.0",
    "jest-environment-jsdom": "30.4.1",
    "jest-junit": "17.0.0",
    "jest-when": "3.7.0",
    "jsdom": "26.1.0",
    "knip": "6.32.2",
    "mini-css-extract-plugin": "2.10.2",
    "msw": "2.15.0",
    "nano-staged": "1.0.2",
    "neostandard": "0.13.0",
    "nodemon": "2.0.22",
    "npm-run-all": "4.1.5",
    "parse-asn1": "5.1.9",
    "patch-package": "8.0.1",
    "pino-pretty": "13.1.3",
    "postinstall-postinstall": "2.1.0",
    "prettier": "3.9.6",
    "resolve-url-loader": "5.0.0",
    "sass": "1.102.0",
    "sass-loader": "16.0.5",
    "webpack": "5.109.2",
    "webpack-cli": "7.2.2"
  },
  "nodemonConfig": {
    "ignore": [
      "**/test-output/**"
    ]
  },
  "nano-staged": {
    "*.js": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  }
}
